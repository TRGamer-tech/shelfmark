# Address of the Supabase project on which supabase/schema.sql has been run.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable key of that project (the one that is meant to be public).
# The first of these three that is set is used. The Vercel Supabase integration
# sets some of them by itself.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google Books often refuses searches without a key. Used on the server only.
# GOOGLE_BOOKS_API_KEY=

# For trying the site against the stand-in server (supabase/dev_server.py):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54340
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_development
